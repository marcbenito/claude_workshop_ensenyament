# Variables d'entorn de l'aplicació.
# Copia aquest fitxer a `.env.local` (desenvolupament) o configura-les al
# proveïdor de desplegament (p. ex. Vercel) per a producció.

# Cadena de connexió a la base de dades Postgres (usada a src/lib/db.ts).
DATABASE_URL=postgresql://usuari:contrasenya@localhost:5432/reserves

# Secret de next-auth v5 (Auth.js). OBLIGATORI en producció.
# Genera'n un amb: npx auth secret
AUTH_SECRET=canvia-aixo-per-un-secret-generat-amb-npx-auth-secret
