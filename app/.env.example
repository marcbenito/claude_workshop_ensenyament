# Variables d'entorn de l'aplicació.
# Copia aquest fitxer a `.env` (o `.env.local`) i emplena els valors reals.

# Cadena de connexió a Postgres.
DATABASE_URL="postgres://usuari:contrasenya@localhost:5432/reserva_sessions"

# Secret de NextAuth v5 (obligatori en producció).
# Genera'n un amb: npx auth secret
AUTH_SECRET="genera-un-secret-amb-npx-auth-secret"

# (Opcional) URL pública del lloc, usada per SEO (sitemap, robots, Open Graph).
NEXT_PUBLIC_SITE_URL="https://reserva-sessions.app"
